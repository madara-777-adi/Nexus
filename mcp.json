{
  "mcpServers": {
    "CodeGraphContext": {
      "command": "/home/aditya/.local/bin/cgc",
      "args": [
        "mcp",
        "start"
      ],
      "env": {
        "DEFAULT_DATABASE": "falkordb",
        "FALKORDB_PATH": "/home/aditya/.codegraphcontext/global/db/falkordb",
        "FALKORDB_SOCKET_PATH": "/home/aditya/.codegraphcontext/global/db/falkordb.sock",
        "FALKORDB_PORT": "",
        "LADYBUGDB_PATH": "/home/aditya/.codegraphcontext/global/db/ladybugdb",
        "KUZUDB_PATH": "/home/aditya/.codegraphcontext/global/db/kuzudb",
        "INDEX_VARIABLES": "true",
        "ALLOW_DB_DELETION": "false",
        "DEBUG_LOGS": "false",
        "DEBUG_LOG_PATH": "/home/aditya/mcp_debug.log",
        "ENABLE_APP_LOGS": "CRITICAL",
        "LIBRARY_LOG_LEVEL": "WARNING",
        "LOG_FILE_PATH": "/home/aditya/.codegraphcontext/logs/cgc.log",
        "MAX_FILE_SIZE_MB": "10",
        "IGNORE_TEST_FILES": "false",
        "IGNORE_HIDDEN_FILES": "true",
        "ENABLE_AUTO_WATCH": "false",
        "COMPLEXITY_THRESHOLD": "10",
        "MAX_DEPTH": "unlimited",
        "PARALLEL_WORKERS": "4",
        "CACHE_ENABLED": "true",
